# ---------------------------------------------------------------------------
# FlowPilot AI backend — copy to .env and adjust
# ---------------------------------------------------------------------------

# Google Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key

# Gemini model used for BOTH planning and user-facing replies (optional).
# Default: gemini-3.7-flash. Set this if that model ID is not available to
# your API key — e.g. GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-3.7-flash

# FlowPilot REST API origin
FLOWPILOT_API_URL=http://localhost:4000

# Port for this AI backend
PORT=3000

# NOTE: there is deliberately no FLOWPILOT_JWT_TOKEN here.
#
# The AI backend acts as the signed-in user: it reads the
# `Authorization: Bearer <JWT>` header from each incoming request and forwards
# that same token to the FlowPilot API. FlowPilot enforces the user's roles and
# permissions, and no shared or service credential is stored on this service.
