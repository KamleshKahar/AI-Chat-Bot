# ---------------------------------------------------------------------------
# FlowPilot backend — copy to .env and adjust
# ---------------------------------------------------------------------------

# MySQL 8.0+ / MariaDB 10.6+
DATABASE_URL="mysql://root:flowpilot@127.0.0.1:3306/flowpilot"
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/flowpilot"

# HTTP server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins (3100 = next dev here,
# because ai-backend holds 3000)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100"

# JWT — CHANGE THIS SECRET IN PRODUCTION
JWT_SECRET="flowpilot-dev-secret-change-me"
JWT_EXPIRES_IN="8h"

# Request body size limit
JSON_LIMIT="1mb"

# No accounts are seeded. On first visit the app opens /setup, which creates
# the initial administrator against an empty users table.